# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

# REQUIRED - Core application settings
PROJECT_NAME="Event Attendance Tracker"
API_V1_STR=/api/v1
SECRET_KEY=your_secret_key_here_change_this_in_production
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:changethis@localhost:5433/app

# Frontend configuration
FRONTEND_HOST=http://localhost:5173

# Email configuration (for password recovery, notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Sentry error tracking (optional)
SENTRY_DSN=

# Security settings
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL password (used by Docker Compose)
POSTGRES_PASSWORD=changethis

# Mailpit email testing (optional, for local development)
MAILPIT_HOST=http://localhost:8025
MAILPIT_PORT=8025
